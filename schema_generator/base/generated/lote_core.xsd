  <xsd:complexType name="MultiLangStringType">
    <xsd:annotation><xsd:documentation>One language-tagged plain-text string.</xsd:documentation></xsd:annotation>
    <xsd:simpleContent><xsd:extension base="lote:PlainTextType"><xsd:attribute ref="xml:lang" use="required"/></xsd:extension></xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="SchemeNameStringType">
    <xsd:simpleContent><xsd:extension base="lote:SchemeNameTextType"><xsd:attribute ref="xml:lang" use="required"/></xsd:extension></xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="MultiLangURIType">
    <xsd:annotation><xsd:documentation>One language-tagged URI (multilingual pointer).</xsd:documentation></xsd:annotation>
    <xsd:simpleContent><xsd:extension base="lote:NonEmptyURIType"><xsd:attribute ref="xml:lang" use="required"/></xsd:extension></xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="MultiLangStringListType">
    <xsd:annotation><xsd:documentation>Non-empty sequence of multilang-text with at least one 'en' entry.</xsd:documentation></xsd:annotation>
    <xsd:sequence><xsd:element name="Name" type="lote:MultiLangStringType" maxOccurs="unbounded"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="SchemeNameListType">
    <xsd:annotation><xsd:documentation>multilang-texts whose values have the form 'CC:name'.</xsd:documentation></xsd:annotation>
    <xsd:sequence><xsd:element name="Name" type="lote:SchemeNameStringType" maxOccurs="unbounded"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="MultiLangURIListType">
    <xsd:annotation><xsd:documentation>Non-empty sequence of multilang-uri with at least one 'en' entry.</xsd:documentation></xsd:annotation>
    <xsd:sequence><xsd:element name="URI" type="lote:MultiLangURIType" maxOccurs="unbounded"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ElectronicAddressType">
    <xsd:annotation><xsd:documentation>multilang-uris containing a mailto: URI and a web-site (http/https) URI; tel: optional. The mailto: and web-site entries are checked by Schematron.</xsd:documentation></xsd:annotation>
    <xsd:sequence><xsd:element name="URI" type="lote:MultiLangURIType" minOccurs="2" maxOccurs="unbounded"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="URIListType">
    <xsd:annotation><xsd:documentation>Non-empty sequence of URIs.</xsd:documentation></xsd:annotation>
    <xsd:sequence><xsd:element name="URI" type="lote:NonEmptyURIType" maxOccurs="unbounded"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="TypedURIType">
    <xsd:annotation><xsd:documentation>URI optionally qualified by a service type URI.</xsd:documentation></xsd:annotation>
    <xsd:simpleContent><xsd:extension base="lote:NonEmptyURIType"><xsd:attribute name="type" type="lote:NonEmptyURIType"/></xsd:extension></xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="AnyType" mixed="true">
    <xsd:annotation><xsd:documentation>Format left open by the text; syntax-specific.</xsd:documentation></xsd:annotation>
    <xsd:sequence minOccurs="0" maxOccurs="unbounded"><xsd:any processContents="lax"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ExtensionType">
    <xsd:annotation><xsd:documentation>Extension whose format is left open, with a mandatory criticality indication (clause 6.3.17).</xsd:documentation></xsd:annotation>
    <xsd:complexContent><xsd:extension base="lote:AnyType"><xsd:attribute name="Critical" type="xsd:boolean" use="required"/></xsd:extension></xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="ExtensionsListType">
    <xsd:annotation><xsd:documentation>Non-empty sequence of extensions whose format is left open.</xsd:documentation></xsd:annotation>
    <xsd:sequence><xsd:element name="Extension" type="lote:ExtensionType" maxOccurs="unbounded"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OptionalCriticalityExtensionType">
    <xsd:annotation><xsd:documentation>Extension whose format is left open; the text does not require a criticality indication here.</xsd:documentation></xsd:annotation>
    <xsd:complexContent><xsd:extension base="lote:AnyType"><xsd:attribute name="Critical" type="xsd:boolean"/></xsd:extension></xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="OptionalCriticalityExtensionsListType">
    <xsd:annotation><xsd:documentation>Non-empty sequence of extensions whose format is left open.</xsd:documentation></xsd:annotation>
    <xsd:sequence><xsd:element name="Extension" type="lote:OptionalCriticalityExtensionType" maxOccurs="unbounded"/></xsd:sequence>
  </xsd:complexType>
</xsd:schema>
