<?xml version="1.0" encoding="UTF-8"?>
<!-- ETSI TS 119 602 V1.1.1 Annex G - WRPRC providers list (generated by lote_schema_generator/gen_profiles_from_model.py). Use together with lote_core.xsd and lote_core.sch.
     Rules-layer requirements (not checkable by a schema):
       - G-seq-1: The first instance of the list is issued with LoTESequenceNumber 1. [checkable: partly: needs the list history] Table G.1 LoTE sequence number (p. 59, line 3468): "LoTESequenceNumber component number set to "1"."
       - G-sch-info: One URI for information about the list and one where all previous instances can be retrieved; one URI may serve both, so the count is not enforced. [checkable: no: content of the pages] Table G.1 Scheme information URI (p. 59, line 3476): "The SchemeInformationURI component shall contain:"
       - G-te-name: TEName is the (legal) name of the listed provider. [checkable: no: needs official records] Table G.2 TE name (p. 60, line 3519): "The value of the TEName component shall be the name of the"
       - G-trade: The official registration identifier where one exists (organizationIdentifier / serialNumber semantics of ETSI EN 319 412-1). [checkable: no: needs official records] Table G.2 TE trade name (p. 60, line 3521): "The TETradeName component shall include an official registration"
       - G-sdi-content: Where applicable, the certificates carry the information that distinguishes registration certificates from other certificates. [checkable: partly: needs certificate parsing] Table G.3 Service digital identity (certificate content) (p. 61, line 3582): "the information required to distinguish"
       - G-removal: An entity or service that loses its approval is removed from the list. [checkable: no: operational process] Table G.3 Service current status (removal) (p. 61, line 3596): "removed from the"
       - G-sig: Signed with a compact JAdES Baseline B signature (ETSI TS 119 182-1). [checkable: yes: with a JAdES / XAdES verifier] G.4 Signature (p. 61, line 3619): "shall be signed by means of a compact JAdES Baseline B signature"
-->
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt">
  <sch:ns prefix="lote" uri="http://uri.etsi.org/019602/v1#"/>
  <sch:ns prefix="tie" uri="http://uri.etsi.org/019602/v1/TrustedEntityExtensions"/>
  <sch:ns prefix="sie" uri="http://uri.etsi.org/019602/v1/ServiceInformationExtensions"/>
  <sch:ns prefix="ds" uri="http://www.w3.org/2000/09/xmldsig#"/>
  <sch:pattern id="p-G-LoTEVersionIdentifier-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEVersionIdentifier">
      <sch:assert id="G-LoTEVersionIdentifier-fixed" test=". = '1'">[G-LoTEVersionIdentifier-fixed] LoTEVersionIdentifier must be "1". Table G.1 LoTE version identifier (p. 59, line 3465): "The value of the LoTEVersionIdentifier component shall be "1"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-LoTEType-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEType">
      <sch:assert id="G-LoTEType-fixed" test=". = 'http://uri.etsi.org/19602/LoTEType/EUWRPRCProvidersList'">[G-LoTEType-fixed] LoTEType must be "http://uri.etsi.org/19602/LoTEType/EUWRPRCProvidersList". Table G.1 LoTE type (p. 59, line 3470): "http://uri.etsi.org/19602/LoTEType/EUWRPRCProvidersList"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-StatusDeterminationApproach-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:StatusDeterminationApproach">
      <sch:assert id="G-StatusDeterminationApproach-fixed" test=". = 'http://uri.etsi.org/19602/WRPRCrovidersList/StatusDetn/EU' or . = 'http://uri.etsi.org/19602/WRPRCProvidersList/StatusDetn/EU'">[G-StatusDeterminationApproach-fixed] StatusDeterminationApproach must be "http://uri.etsi.org/19602/WRPRCrovidersList/StatusDetn/EU" or "http://uri.etsi.org/19602/WRPRCProvidersList/StatusDetn/EU". Table G.1 Status determination approach (p. 59, line 3480): "http://uri.etsi.org/19602/WRPRCrovidersList/StatusDetn/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-SchemeTypeCommunityRules-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTypeCommunityRules/lote:URI">
      <sch:assert id="G-SchemeTypeCommunityRules-fixed" test=". = 'http://uri.etsi.org/19602/WRPRCProvidersList/schemerules/EU'">[G-SchemeTypeCommunityRules-fixed] SchemeTypeCommunityRules must be "http://uri.etsi.org/19602/WRPRCProvidersList/schemerules/EU". Table G.1 Scheme type/community/rules (p. 59, line 3482): "http://uri.etsi.org/19602/WRPRCProvidersList/schemerules/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-SchemeTerritory-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTerritory">
      <sch:assert id="G-SchemeTerritory-fixed" test=". = 'EU'">[G-SchemeTerritory-fixed] SchemeTerritory must be "EU". Table G.1 Scheme territory (p. 59, line 3484): "The value of the SchemeTerritory component shall be "EU"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-next-6m">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="G-next-6m" test="not(lote:NextUpdate/lote:dateTime) or (number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) &lt; (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 or ((number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) = (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 and number(translate(substring(lote:NextUpdate/lote:dateTime, 9), 'T:Z', '')) &lt;= number(translate(substring(lote:ListIssueDateTime, 9), 'T:Z', '')))">[G-next-6m] NextUpdate is at most 6 months after ListIssueDateTime.. Table G.1 Next update (p. 59, line 3495): "The maximum value between the list issue date and time and the next update shall be 6 months."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-HistoricalInformationPeriod-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="G-HistoricalInformationPeriod-prohibited" test="not(lote:HistoricalInformationPeriod)">[G-HistoricalInformationPeriod-prohibited] HistoricalInformationPeriod must not be present. Table G.1 Historical information period (p. 59, line 3488): "The HistoricalInformationPeriod component shall not be present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-PointersToOtherLoTE-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="G-PointersToOtherLoTE-required" test="lote:PointersToOtherLoTE">[G-PointersToOtherLoTE-required] PointersToOtherLoTE is required. Table G.1 Pointers to other LoTEs (p. 59, line 3491): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-ptr-self">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:PointersToOtherLoTE">
      <sch:assert id="G-ptr-self" test="lote:OtherLoTEPointer[lote:LoTEQualifiers/lote:LoTEQualifier[lote:LoTEType = 'http://uri.etsi.org/19602/LoTEType/EUWRPRCProvidersList']]">[G-ptr-self] One pointer designates this list itself (identified here by its LoTEType qualifier).. Table G.1 Pointers to other LoTEs (p. 59, line 3491): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-te-tel">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation/lote:TEAddress">
      <sch:assert id="G-te-tel" test="lote:TEElectronicAddress/lote:URI[(starts-with(., 'tel:'))]">[G-te-tel] The electronic address contains a contact phone number (tel: URI).. Table G.2 TE address (p. 60, line 3537): "contact email and contact phone number"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-te-info-count">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="G-te-info-count" test="count(lote:TEInformationURI/lote:URI) &gt;= 2">[G-te-info-count] At least the policy page (a) and the Member State URI (c).. Table G.2 TE information URI (p. 60, line 3540): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-te-info-a">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="G-te-info-a" test="lote:TEInformationURI/lote:URI[(starts-with(., 'http://') or starts-with(., 'https://')) and not(starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/'))]">[G-te-info-a] (a) An http(s) page with the provider's policies, terms and conditions.. Table G.2 TE information URI (p. 60, line 3540): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-te-cc">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="G-te-cc" test="lote:TEInformationURI/lote:URI[starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/WRPRCProvider/') and contains(' AT BE BG CY CZ DE DK EE EL ES FI FR HR HU IE IT LT LU LV MT NL PL PT RO SE SI SK ', concat(' ', substring-after(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/WRPRCProvider/'), ' '))]">[G-te-cc] (c) http://uri.etsi.org/19602/ListOfTrustedEntities/WRPRCProvider/CC for the responsible Member State ('CC' field: Greece = EL, clause 6.1.5).. Table G.2 TE information URI (Member State URI) (p. 60, line 3549): ""CC" is replaced by the ISO 3166-1 [2] Alpha 2 code of the Member State which is responsible for that"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-ServiceTypeIdentifier-values">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceTypeIdentifier">
      <sch:assert id="G-ServiceTypeIdentifier-values" test=". = 'http://uri.etsi.org/19602/SvcType/WRPRC/Issuance' or . = 'http://uri.etsi.org/19602/SvcType/WRPRC/Revocation'">[G-ServiceTypeIdentifier-values] ServiceTypeIdentifier must be one of the allowed values. Table G.3 Service type identifier (p. 61, line 3571): "to the exclusion of any other"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-X509Certificate-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceDigitalIdentity">
      <sch:assert id="G-X509Certificate-required" test="lote:DigitalId/lote:X509Certificate">[G-X509Certificate-required] X509Certificate is required. Table G.3 Service digital identity (p. 61, line 3579): "The ServiceDigitalIdentity component shall contain one or more"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-ServiceStatus-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="G-ServiceStatus-prohibited" test="not(lote:ServiceStatus)">[G-ServiceStatus-prohibited] ServiceStatus must not be present. Table G.3 Service current status (p. 61, line 3585): "The ServiceStatus component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-StatusStartingTime-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="G-StatusStartingTime-prohibited" test="not(lote:StatusStartingTime)">[G-StatusStartingTime-prohibited] StatusStartingTime must not be present. Table G.3 Current status starting date and time (p. 61, line 3597): "The StatusStartingTime component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-G-ServiceHistory-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService">
      <sch:assert id="G-ServiceHistory-prohibited" test="not(lote:ServiceHistory)">[G-ServiceHistory-prohibited] ServiceHistory must not be present. Table G.1 Historical information period (consequence) (p. 59, line 3489): "historical information is not kept in the list"</sch:assert>
    </sch:rule>
  </sch:pattern>
</sch:schema>
