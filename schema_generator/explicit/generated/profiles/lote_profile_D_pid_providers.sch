<?xml version="1.0" encoding="UTF-8"?>
<!-- ETSI TS 119 602 V1.1.1 Annex D - PID providers list (generated by lote_schema_generator/gen_profiles_from_model.py). Use together with lote_core.xsd and lote_core.sch.
     Rules-layer requirements (not checkable by a schema):
       - D-seq-1: The first instance of the list is issued with LoTESequenceNumber 1. [checkable: partly: needs the list history] Table D.1 LoTE sequence number (p. 47, line 2861): "LoTESequenceNumber component number set to "1"."
       - D-sch-info: One URI for information about the list and one where all previous instances can be retrieved; one URI may serve both, so the count is not enforced. [checkable: no: content of the pages] Table D.1 Scheme information URI (p. 47, line 2869): "The SchemeInformationURI component shall contain:"
       - D-te-name: TEName is the (legal) name of the listed provider. [checkable: no: needs official records] Table D.2 TE name (p. 47, line 2907): "The value of the TEName component shall be the name of the"
       - D-trade: The official registration identifier where one exists (organizationIdentifier / serialNumber semantics of ETSI EN 319 412-1). [checkable: no: needs official records] Table D.2 TE trade name (p. 48, line 2918): "The TETradeName component shall include an official registration"
       - D-assoc: Where applicable, OtherAssociatedBodies names the associated body responsible for associating the PID with the wallet unit. [checkable: no: 'where applicable'] Table D.2 TE information extensions (p. 48, line 2946): "Where applicable, the OtherAssociatedBody extension shall be used"
       - D-sdi-content: The certificates certify the TEName and, where applicable, the TETradeName registration number. [checkable: partly: needs certificate parsing] Table D.3 Service digital identity (certificate content) (p. 49, line 2978): "for which the certified identity data include the name"
       - D-removal: An entity or service that loses its approval is removed from the list. [checkable: no: operational process] Table D.3 Service current status (removal) (p. 49, line 2993): "removed from the"
       - D-sig: Signed with a compact JAdES Baseline B signature (ETSI TS 119 182-1). [checkable: yes: with a JAdES / XAdES verifier] D.4 Signature (p. 49, line 3016): "shall be signed by means of a compact JAdES Baseline B signature"
-->
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt">
  <sch:ns prefix="lote" uri="http://uri.etsi.org/019602/v1#"/>
  <sch:ns prefix="tie" uri="http://uri.etsi.org/019602/v1/TrustedEntityExtensions"/>
  <sch:ns prefix="sie" uri="http://uri.etsi.org/019602/v1/ServiceInformationExtensions"/>
  <sch:ns prefix="ds" uri="http://www.w3.org/2000/09/xmldsig#"/>
  <sch:pattern id="p-D-LoTEVersionIdentifier-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEVersionIdentifier">
      <sch:assert id="D-LoTEVersionIdentifier-fixed" test=". = '1'">[D-LoTEVersionIdentifier-fixed] LoTEVersionIdentifier must be "1". Table D.1 LoTE version identifier (p. 47, line 2858): "The value of the LoTEVersionIdentifier component shall be "1"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-LoTEType-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEType">
      <sch:assert id="D-LoTEType-fixed" test=". = 'http://uri.etsi.org/19602/LoTEType/EUPIDProvidersList'">[D-LoTEType-fixed] LoTEType must be "http://uri.etsi.org/19602/LoTEType/EUPIDProvidersList". Table D.1 LoTE type (p. 47, line 2863): "http://uri.etsi.org/19602/LoTEType/EUPIDProvidersList"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-StatusDeterminationApproach-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:StatusDeterminationApproach">
      <sch:assert id="D-StatusDeterminationApproach-fixed" test=". = 'http://uri.etsi.org/19602/PIDProvidersList/StatusDetn/EU'">[D-StatusDeterminationApproach-fixed] StatusDeterminationApproach must be "http://uri.etsi.org/19602/PIDProvidersList/StatusDetn/EU". Table D.1 Status determination approach (p. 47, line 2875): "http://uri.etsi.org/19602/PIDProvidersList/StatusDetn/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-SchemeTypeCommunityRules-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTypeCommunityRules/lote:URI">
      <sch:assert id="D-SchemeTypeCommunityRules-fixed" test=". = 'http://uri.etsi.org/19602/PIDProviders/schemerules/EU'">[D-SchemeTypeCommunityRules-fixed] SchemeTypeCommunityRules must be "http://uri.etsi.org/19602/PIDProviders/schemerules/EU". Table D.1 Scheme type/community/rules (p. 47, line 2877): "http://uri.etsi.org/19602/PIDProviders/schemerules/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-SchemeTerritory-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTerritory">
      <sch:assert id="D-SchemeTerritory-fixed" test=". = 'EU'">[D-SchemeTerritory-fixed] SchemeTerritory must be "EU". Table D.1 Scheme territory (p. 47, line 2879): "The value of the SchemeTerritory component shall be "EU"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-next-6m">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="D-next-6m" test="not(lote:NextUpdate/lote:dateTime) or (number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) &lt; (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 or ((number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) = (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 and number(translate(substring(lote:NextUpdate/lote:dateTime, 9), 'T:Z', '')) &lt;= number(translate(substring(lote:ListIssueDateTime, 9), 'T:Z', '')))">[D-next-6m] NextUpdate is at most 6 months after ListIssueDateTime.. Table D.1 Next update (p. 47, line 2890): "The maximum value between the list issue date and time and the next update shall be 6 months."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-HistoricalInformationPeriod-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="D-HistoricalInformationPeriod-prohibited" test="not(lote:HistoricalInformationPeriod)">[D-HistoricalInformationPeriod-prohibited] HistoricalInformationPeriod must not be present. Table D.1 Historical information period (p. 47, line 2883): "The HistoricalInformationPeriod component shall not be present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-PointersToOtherLoTE-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="D-PointersToOtherLoTE-required" test="lote:PointersToOtherLoTE">[D-PointersToOtherLoTE-required] PointersToOtherLoTE is required. Table D.1 Pointers to other LoTEs (p. 47, line 2886): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-ptr-self">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:PointersToOtherLoTE">
      <sch:assert id="D-ptr-self" test="lote:OtherLoTEPointer[lote:LoTEQualifiers/lote:LoTEQualifier[lote:LoTEType = 'http://uri.etsi.org/19602/LoTEType/EUPIDProvidersList']]">[D-ptr-self] One pointer designates this list itself (identified here by its LoTEType qualifier).. Table D.1 Pointers to other LoTEs (p. 47, line 2886): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-te-tel">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation/lote:TEAddress">
      <sch:assert id="D-te-tel" test="lote:TEElectronicAddress/lote:URI[(starts-with(., 'tel:'))]">[D-te-tel] The electronic address contains a contact phone number (tel: URI).. Table D.2 TE address (p. 48, line 2931): "contact email and contact phone number"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-te-info-count">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="D-te-info-count" test="count(lote:TEInformationURI/lote:URI) &gt;= 2">[D-te-info-count] At least the policy page (a) and the Member State URI (c).. Table D.2 TE information URI (p. 48, line 2934): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-te-info-a">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="D-te-info-a" test="lote:TEInformationURI/lote:URI[(starts-with(., 'http://') or starts-with(., 'https://')) and not(starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/'))]">[D-te-info-a] (a) An http(s) page with the provider's policies, terms and conditions.. Table D.2 TE information URI (p. 48, line 2934): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-te-cc">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="D-te-cc" test="lote:TEInformationURI/lote:URI[starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/PIDProvider/') and contains(' AT BE BG CY CZ DE DK EE EL ES FI FR HR HU IE IT LT LU LV MT NL PL PT RO SE SI SK ', concat(' ', substring-after(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/PIDProvider/'), ' '))]">[D-te-cc] (c) http://uri.etsi.org/19602/ListOfTrustedEntities/PIDProvider/CC for the responsible Member State ('CC' field: Greece = EL, clause 6.1.5).. Table D.2 TE information URI (Member State URI) (p. 48, line 2943): ""CC" is replaced by the ISO 3166-1 [2] Alpha 2 code of the Member State which is responsible for that"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-ServiceTypeIdentifier-values">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceTypeIdentifier">
      <sch:assert id="D-ServiceTypeIdentifier-values" test=". = 'http://uri.etsi.org/19602/SvcType/PID/Issuance' or . = 'http://uri.etsi.org/19602/SvcType/PID/Revocation'">[D-ServiceTypeIdentifier-values] ServiceTypeIdentifier must be one of the allowed values. Table D.3 Service type identifier (p. 49, line 2968): "to the exclusion of any other"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-X509Certificate-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceDigitalIdentity">
      <sch:assert id="D-X509Certificate-required" test="lote:DigitalId/lote:X509Certificate">[D-X509Certificate-required] X509Certificate is required. Table D.3 Service digital identity (p. 49, line 2975): "The ServiceDigitalIdentity component shall contain one or more"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-ServiceStatus-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="D-ServiceStatus-prohibited" test="not(lote:ServiceStatus)">[D-ServiceStatus-prohibited] ServiceStatus must not be present. Table D.3 Service current status (p. 49, line 2981): "The ServiceStatus component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-StatusStartingTime-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="D-StatusStartingTime-prohibited" test="not(lote:StatusStartingTime)">[D-StatusStartingTime-prohibited] StatusStartingTime must not be present. Table D.3 Current status starting date and time (p. 49, line 2994): "The StatusStartingTime component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-D-ServiceHistory-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService">
      <sch:assert id="D-ServiceHistory-prohibited" test="not(lote:ServiceHistory)">[D-ServiceHistory-prohibited] ServiceHistory must not be present. Table D.1 Historical information period (consequence) (p. 47, line 2884): "historical information is not kept in the list"</sch:assert>
    </sch:rule>
  </sch:pattern>
</sch:schema>
