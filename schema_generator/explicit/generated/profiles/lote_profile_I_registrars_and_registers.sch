<?xml version="1.0" encoding="UTF-8"?>
<!-- ETSI TS 119 602 V1.1.1 Annex I - List of registrars and registers (generated by lote_schema_generator/gen_profiles_from_model.py). Use together with lote_core.xsd and lote_core.sch.
     Rules-layer requirements (not checkable by a schema):
       - I-seq-1: The first instance of the list is issued with LoTESequenceNumber 1. [checkable: partly: needs the list history] Table I.1 LoTE sequence number (p. 67, line 3918): "LoTESequenceNumber component number set to "1"."
       - I-sch-info: One URI for information about the list and one where all previous instances can be retrieved; one URI may serve both, so the count is not enforced. [checkable: no: content of the pages] Table I.1 Scheme information URI (p. 67, line 3926): "The SchemeInformationURI component shall contain:"
       - I-te-name: TEName is the (legal) name of the listed provider. [checkable: no: needs official records] Table I.2 TE name (p. 68, line 3973): "The value of the TEName component shall be the name of the"
       - I-trade: Where applicable, the registration number of the registrar. [checkable: no: needs official records] Table I.2 TE trade name (p. 68, line 3975): "The TETradeName component shall include, where applicable,"
       - I-svc-name: The name of the register the registrar is responsible for. [checkable: no: needs official records] Table I.3 Service name (p. 68, line 4006): "The ServiceName component shall contain the name of the register for which"
       - I-sdi-content: The certificates certify the TEName and, where applicable, the TETradeName registration number. [checkable: partly: needs certificate parsing] Table I.3 Service digital identity (certificate content) (p. 69, line 4019): "for which the certified identity data include"
       - I-removal: An entity or service that loses its approval is removed from the list. [checkable: no: operational process] Table I.3 Service current status (removal) (p. 69, line 4034): "removed from the"
       - I-ssp-auth: Register data obtained there can be authenticated with a listed certificate. [checkable: partly: needs the register data] Table I.3 Service supply points (authenticity) (p. 69, line 4049): "shall be able to be authenticated using"
       - I-sig: Signed with a compact JAdES Baseline B signature (ETSI TS 119 182-1). [checkable: yes: with a JAdES / XAdES verifier] I.4 Signature (p. 69, line 4061): "shall be signed by means of a compact JAdES Baseline B signature"
-->
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt">
  <sch:ns prefix="lote" uri="http://uri.etsi.org/019602/v1#"/>
  <sch:ns prefix="tie" uri="http://uri.etsi.org/019602/v1/TrustedEntityExtensions"/>
  <sch:ns prefix="sie" uri="http://uri.etsi.org/019602/v1/ServiceInformationExtensions"/>
  <sch:ns prefix="ds" uri="http://www.w3.org/2000/09/xmldsig#"/>
  <sch:pattern id="p-I-LoTEVersionIdentifier-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEVersionIdentifier">
      <sch:assert id="I-LoTEVersionIdentifier-fixed" test=". = '1'">[I-LoTEVersionIdentifier-fixed] LoTEVersionIdentifier must be "1". Table I.1 LoTE version identifier (p. 67, line 3915): "The value of the LoTEVersionIdentifier component shall be "1"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-LoTEType-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEType">
      <sch:assert id="I-LoTEType-fixed" test=". = 'http://uri.etsi.org/19602/LoTEType/EURegistrarsAndRegistersList'">[I-LoTEType-fixed] LoTEType must be "http://uri.etsi.org/19602/LoTEType/EURegistrarsAndRegistersList". Table I.1 LoTE type (p. 67, line 3920): "http://uri.etsi.org/19602/LoTEType/EURegistrarsAndRegistersList"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-StatusDeterminationApproach-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:StatusDeterminationApproach">
      <sch:assert id="I-StatusDeterminationApproach-fixed" test=". = 'http://uri.etsi.org/19602/RegistrarsAndRegistersList/StatusDetn/EU'">[I-StatusDeterminationApproach-fixed] StatusDeterminationApproach must be "http://uri.etsi.org/19602/RegistrarsAndRegistersList/StatusDetn/EU". Table I.1 Status determination approach (p. 67, line 3932): "http://uri.etsi.org/19602/RegistrarsAndRegistersList/StatusDetn/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-SchemeTypeCommunityRules-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTypeCommunityRules/lote:URI">
      <sch:assert id="I-SchemeTypeCommunityRules-fixed" test=". = 'http://uri.etsi.org/19602/RegistrarsAndRegistersList/schemerules/EU'">[I-SchemeTypeCommunityRules-fixed] SchemeTypeCommunityRules must be "http://uri.etsi.org/19602/RegistrarsAndRegistersList/schemerules/EU". Table I.1 Scheme type/community/rules (p. 67, line 3934): "http://uri.etsi.org/19602/RegistrarsAndRegistersList/schemerules/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-SchemeTerritory-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTerritory">
      <sch:assert id="I-SchemeTerritory-fixed" test=". = 'EU'">[I-SchemeTerritory-fixed] SchemeTerritory must be "EU". Table I.1 Scheme territory (p. 67, line 3936): "The value of the SchemeTerritory component shall be "EU"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-next-6m">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="I-next-6m" test="not(lote:NextUpdate/lote:dateTime) or (number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) &lt; (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 or ((number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) = (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 and number(translate(substring(lote:NextUpdate/lote:dateTime, 9), 'T:Z', '')) &lt;= number(translate(substring(lote:ListIssueDateTime, 9), 'T:Z', '')))">[I-next-6m] NextUpdate is at most 6 months after ListIssueDateTime.. Table I.1 Next update (p. 68, line 3956): "The maximum value between the list issue date and time and the next update shall be 6 months."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-HistoricalInformationPeriod-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="I-HistoricalInformationPeriod-prohibited" test="not(lote:HistoricalInformationPeriod)">[I-HistoricalInformationPeriod-prohibited] HistoricalInformationPeriod must not be present. Table I.1 Historical information period (p. 67, line 3940): "The HistoricalInformationPeriod component shall not be present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-PointersToOtherLoTE-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="I-PointersToOtherLoTE-required" test="lote:PointersToOtherLoTE">[I-PointersToOtherLoTE-required] PointersToOtherLoTE is required. Table I.1 Pointers to other LoTEs (p. 68, line 3952): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-ptr-self">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:PointersToOtherLoTE">
      <sch:assert id="I-ptr-self" test="lote:OtherLoTEPointer[lote:LoTEQualifiers/lote:LoTEQualifier[lote:LoTEType = 'http://uri.etsi.org/19602/LoTEType/EURegistrarsAndRegistersList']]">[I-ptr-self] One pointer designates this list itself (identified here by its LoTEType qualifier).. Table I.1 Pointers to other LoTEs (p. 68, line 3952): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-te-tel">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation/lote:TEAddress">
      <sch:assert id="I-te-tel" test="lote:TEElectronicAddress/lote:URI[(starts-with(., 'tel:'))]">[I-te-tel] The electronic address contains a contact phone number (tel: URI).. Table I.2 TE address (p. 68, line 3979): "contact email and contact phone number"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-te-info-count">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="I-te-info-count" test="count(lote:TEInformationURI/lote:URI) &gt;= 2">[I-te-info-count] At least the policy page (a) and the Member State URI (c).. Table I.2 TE information URI (p. 68, line 3982): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-te-info-a">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="I-te-info-a" test="lote:TEInformationURI/lote:URI[(starts-with(., 'http://') or starts-with(., 'https://')) and not(starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/'))]">[I-te-info-a] (a) An http(s) page with the provider's policies, terms and conditions.. Table I.2 TE information URI (p. 68, line 3982): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-te-cc">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="I-te-cc" test="lote:TEInformationURI/lote:URI[starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/Registrar/') and contains(' AT BE BG CY CZ DE DK EE EL ES FI FR HR HU IE IT LT LU LV MT NL PL PT RO SE SI SK ', concat(' ', substring-after(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/Registrar/'), ' '))]">[I-te-cc] (c) http://uri.etsi.org/19602/ListOfTrustedEntities/Registrar/CC for the responsible Member State ('CC' field: Greece = EL, clause 6.1.5).. Table I.2 TE information URI (Member State URI) (p. 68, line 3989): ""CC" is replaced by the ISO 3166-1 [2] Alpha 2 code of the Member State which is responsible for that"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-ServiceTypeIdentifier-values">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceTypeIdentifier">
      <sch:assert id="I-ServiceTypeIdentifier-values" test=". = 'http://uri.etsi.org/19602/SvcType/Register'">[I-ServiceTypeIdentifier-values] ServiceTypeIdentifier must be one of the allowed values. Table I.3 Service type identifier (p. 68, line 4004): "to the exclusion of any other"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-X509Certificate-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceDigitalIdentity">
      <sch:assert id="I-X509Certificate-required" test="lote:DigitalId/lote:X509Certificate">[I-X509Certificate-required] X509Certificate is required. Table I.3 Service digital identity (p. 69, line 4017): "The ServiceDigitalIdentity component shall contain one or more"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-ServiceStatus-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="I-ServiceStatus-prohibited" test="not(lote:ServiceStatus)">[I-ServiceStatus-prohibited] ServiceStatus must not be present. Table I.3 Service current status (p. 69, line 4023): "The ServiceStatus component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-StatusStartingTime-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="I-StatusStartingTime-prohibited" test="not(lote:StatusStartingTime)">[I-StatusStartingTime-prohibited] StatusStartingTime must not be present. Table I.3 Current status starting date and time (p. 69, line 4035): "The StatusStartingTime component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-ServiceHistory-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService">
      <sch:assert id="I-ServiceHistory-prohibited" test="not(lote:ServiceHistory)">[I-ServiceHistory-prohibited] ServiceHistory must not be present. Table I.1 Historical information period (consequence) (p. 67, line 3941): "historical information is not kept in the list"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-I-ServiceSupplyPoints-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="I-ServiceSupplyPoints-required" test="lote:ServiceSupplyPoints">[I-ServiceSupplyPoints-required] ServiceSupplyPoints is required. Table I.3 Service supply points (p. 69, line 4046): "The ServiceSupplyPoint component shall contain the URI where the register is"</sch:assert>
    </sch:rule>
  </sch:pattern>
</sch:schema>
