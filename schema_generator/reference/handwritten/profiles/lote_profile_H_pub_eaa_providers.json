{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETSI TS 119 602 V1.1.1 Annex H - Pub-EAA providers list (LoTE profile, JSON binding)",
  "description": "Profile of Annex H: a LoTE valid against the core schema (1960201_json_schema_text_based.json) that also meets the additional requirements of Tables H.1-H.3.",
  "$comment": "Not expressible in JSON Schema, to be enforced by a business-rules layer: Table H.1 LoTE sequence number: the first instance is issued with LoTESequenceNumber 1 (needs the list history). Table H.1 Next update: at most 6 months after ListIssueDateTime (date arithmetic across fields). Table H.2 TE name: the name of the provider used in formal legal registrations and official records. Table H.2 TE trade name: the official registration identifier where one exists, with the semantics of organizationIdentifier / serialNumber in ETSI EN 319 412-1. Table H.1 Scheme information URI: points to information about the list. Table H.3 Service digital identity: multiple certificates relate to one public key and have identical subject names; the subject organizationName is present and strictly matches TEName (requires certificate parsing). Table H.3 Service current status: when an entity is no longer a provider, all of its services are set to withdrawn. Table H.3 Current status starting date and time: not before the (re)issuance of the LoTE. H.1/H.4: the XML binding with an enveloped XAdES Baseline B signature is also allowed; this schema covers the JSON binding only. Clause H.4: signature (JSON binding): compact JAdES Baseline B (ETSI TS 119 182-1).",
  "allOf": [
    {
      "$ref": "../1960201_json_schema_text_based.json"
    }
  ],
  "properties": {
    "LoTE": {
      "properties": {
        "ListAndSchemeInformation": {
          "description": "Table H.1. Profile lists are scheme-explicit (clause H.1), so every explicit element is required.",
          "properties": {
            "LoTEVersionIdentifier": {
              "description": "Table H.1, clause 6.3.1: shall be 1.",
              "const": 1
            },
            "LoTEType": {
              "description": "Table H.1, clause 6.3.3.",
              "const": "http://uri.etsi.org/19602/LoTEType/EUPubEAAProvidersList"
            },
            "StatusDeterminationApproach": {
              "description": "Table H.1, clause 6.3.8.",
              "const": "http://uri.etsi.org/19602/PubEAAProvidersList/StatusDetn/EU"
            },
            "SchemeTypeCommunityRules": {
              "description": "Table H.1, clause 6.3.9.",
              "items": {
                "properties": {
                  "uriValue": {
                    "const": "http://uri.etsi.org/19602/PubEAAProvidersList/schemerules/EU"
                  }
                }
              }
            },
            "SchemeTerritory": {
              "description": "Table H.1, clause 6.3.10.",
              "const": "EU"
            },
            "HistoricalInformationPeriod": {
              "description": "Table H.1, clause 6.3.12: shall be present with value 65535.",
              "const": 65535
            },
            "PointersToOtherLoTE": {
              "description": "Table H.1, clause 6.3.13: shall not be present.",
              "not": {}
            }
          },
          "required": [
            "LoTEType",
            "SchemeOperatorAddress",
            "SchemeName",
            "SchemeInformationURI",
            "StatusDeterminationApproach",
            "SchemeTypeCommunityRules",
            "SchemeTerritory",
            "PolicyOrLegalNotice",
            "HistoricalInformationPeriod"
          ]
        },
        "TrustedEntitiesList": {
          "items": {
            "properties": {
              "TrustedEntityInformation": {
                "description": "Table H.2",
                "properties": {
                  "TETradeName": {
                    "description": "Table H.2, clause 6.5.2 b): shall include the reference to the Union or national law, formatted as 'OJ:' + 'EU' or the ISO 3166-1 code of the EU Member State + the law identifier.",
                    "contains": {
                      "properties": {
                        "value": {
                          "pattern": "^OJ:(EU|AT|BE|BG|CY|CZ|DE|DK|EE|ES|FI|FR|GR|HR|HU|IE|IT|LT|LU|LV|MT|NL|PL|PT|RO|SE|SI|SK).+$"
                        }
                      }
                    }
                  },
                  "TEAddress": {
                    "description": "Table H.2, clause 6.5.3: postal address, contact e-mail and phone, and the URI http://uri.etsi.org/19602/ListOfTrustedEntities/PubEAAProvider/CC.",
                    "properties": {
                      "TEElectronicAddress": {
                        "allOf": [
                          {
                            "description": "Web-site (clause 6.3.5.2); the ListOfTrustedEntities URI below does not count as one.",
                            "contains": {
                              "properties": {
                                "uriValue": {
                                  "pattern": "^https?://(?!uri\\.etsi\\.org/19602/ListOfTrustedEntities/)"
                                }
                              },
                              "required": [
                                "uriValue"
                              ]
                            }
                          },
                          {
                            "description": "Contact phone number (c. 6.5.3 b).",
                            "contains": {
                              "properties": {
                                "uriValue": {
                                  "pattern": "^tel:"
                                }
                              },
                              "required": [
                                "uriValue"
                              ]
                            }
                          },
                          {
                            "description": "Responsible Member State URI (c. 6.5.3 c).",
                            "contains": {
                              "properties": {
                                "uriValue": {
                                  "pattern": "^http://uri\\.etsi\\.org/19602/ListOfTrustedEntities/PubEAAProvider/(AT|BE|BG|CY|CZ|DE|DK|EE|EL|ES|FI|FR|HR|HU|IE|IT|LT|LU|LV|MT|NL|PL|PT|RO|SE|SI|SK)$"
                                }
                              },
                              "required": [
                                "uriValue"
                              ]
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "TETradeName"
                ]
              },
              "TrustedEntityServices": {
                "items": {
                  "properties": {
                    "ServiceInformation": {
                      "description": "Table H.3",
                      "properties": {
                        "ServiceTypeIdentifier": {
                          "description": "Table H.3, clause 6.6.1: to the exclusion of any other.",
                          "enum": [
                            "http://uri.etsi.org/19602/SvcType/PubEAA/Issuance",
                            "http://uri.etsi.org/19602/SvcType/PubEAA/Revocation"
                          ]
                        },
                        "ServiceStatus": {
                          "description": "Table H.3, clause 6.6.4: shall be present, to the exclusion of any other value.",
                          "enum": [
                            "http://uri.etsi.org/19602/PubEAAProvidersList/SvcStatus/notified",
                            "http://uri.etsi.org/19602/PubEAAProvidersList/SvcStatus/withdrawn"
                          ]
                        }
                      },
                      "required": [
                        "ServiceStatus"
                      ]
                    },
                    "ServiceHistory": {
                      "items": {
                        "properties": {
                          "ServiceDigitalIdentity": {
                            "description": "Table H.3, clause 6.4.4: in history instances, at least X509SKIs and no X509Certificates.",
                            "required": [
                              "X509SKIs"
                            ],
                            "properties": {
                              "X509Certificates": {
                                "not": {}
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
