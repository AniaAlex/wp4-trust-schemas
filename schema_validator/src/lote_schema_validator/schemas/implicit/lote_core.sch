<?xml version="1.0" encoding="UTF-8"?>
<!-- ETSI TS 119 602 V1.1.1 - rules of the LoTE XML binding that XSD 1.0 cannot express (generated by gen_xsd.py). -->
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt">
  <sch:ns prefix="lote" uri="http://uri.etsi.org/019602/v1#"/>
  <sch:pattern id="R-StatusWithHistory">
    <sch:rule context="lote:ServiceInformation">
      <sch:assert test="not(/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:HistoricalInformationPeriod &gt;= 1) or lote:ServiceStatus">R-StatusWithHistory (clause 6.6.0, p. 32): If HistoricalInformationPeriod is present with a non-zero value, every ServiceInformation contains ServiceStatus.</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="R-SchemeInfoPlacement">
    <sch:rule context="lote:ListOfTrustedEntities">
      <sch:assert test="(lote:ListAndSchemeInformation and not(lote:LoTEVersionIdentifier or lote:LoTESequenceNumber or lote:SchemeOperatorName or lote:ListIssueDateTime or lote:NextUpdate)) or (lote:LoTEVersionIdentifier and lote:LoTESequenceNumber and lote:SchemeOperatorName and lote:ListIssueDateTime and lote:NextUpdate and not(lote:ListAndSchemeInformation))">R-SchemeInfoPlacement (clause 6.3.0, p. 16): The list information is either in ListAndSchemeInformation or, in a list without that component (implicit scheme information), directly in the list: LoTEVersionIdentifier, LoTESequenceNumber, SchemeOperatorName, ListIssueDateTime and NextUpdate. Never both.</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="R-English">
    <sch:rule context="*[*[@xml:lang]]">
      <sch:assert test="*[@xml:lang = 'en']">R-English (clause 6.1.4, p. 14): Every multilingual sequence contains an entry with language 'en' (interpretation 2).</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="LanguageTagCase">
    <sch:rule context="*[@xml:lang]">
      <sch:assert test="string-length(substring-before(concat(@xml:lang, '-'), '-')) &gt;= 2 and string-length(substring-before(concat(@xml:lang, '-'), '-')) &lt;= 3 and translate(substring-before(concat(@xml:lang, '-'), '-'), 'abcdefghijklmnopqrstuvwxyz', '') = ''">Clause 6.1.4: the language tag "<sch:value-of select="@xml:lang"/>" must start with a 2-3 letter lower-case language code.</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="CountryCodeExclusions">
    <sch:rule context="lote:SchemeTerritory">
      <sch:assert test="not(. = 'GB' or . = 'GR')">Clause 6.1.5 a): the United Kingdom is "UK" and Greece is "EL".</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="ElectronicAddressContent">
    <sch:rule context="lote:ElectronicAddress | lote:TEElectronicAddress | lote:AssociatedBodyElectronicAddress">
      <sch:assert test="lote:URI[starts-with(., 'mailto:')] and lote:URI[starts-with(., 'http://') or starts-with(., 'https://')]">Clause 6.3.5.2: an electronic address contains a mailto: URI and a web-site URI.</sch:assert>
    </sch:rule>
  </sch:pattern>
</sch:schema>
