<?xml version="1.0" encoding="UTF-8"?>
<!-- ETSI TS 119 602 V1.1.1 Annex F - WRPAC providers list (generated by lote_schema_generator/gen_profiles_from_model.py). Use together with lote_core.xsd and lote_core.sch.
     Rules-layer requirements (not checkable by a schema):
       - F-seq-1: The first instance of the list is issued with LoTESequenceNumber 1. [checkable: partly: needs the list history] Table F.1 LoTE sequence number (p. 55, line 3269): "LoTESequenceNumber component number set to "1"."
       - F-sch-info: One URI for information about the list and one where all previous instances can be retrieved; one URI may serve both, so the count is not enforced. [checkable: no: content of the pages] Table F.1 Scheme information URI (p. 55, line 3277): "The SchemeInformationURI component shall contain:"
       - F-te-name: TEName is the (legal) name of the listed provider. [checkable: no: needs official records] Table F.2 TE name (p. 56, line 3320): "The value of the TEName component shall be the name of the"
       - F-trade: The official registration identifier where one exists (organizationIdentifier / serialNumber semantics of ETSI EN 319 412-1). [checkable: no: needs official records] Table F.2 TE trade name (p. 56, line 3322): "The TETradeName component shall include an official registration"
       - F-sdi-content: Where applicable, the certificates carry the information that distinguishes access certificates from other certificates. [checkable: partly: needs certificate parsing] Table F.3 Service digital identity (certificate content) (p. 57, line 3382): "the information required to distinguish"
       - F-removal: An entity or service that loses its approval is removed from the list. [checkable: no: operational process] Table F.3 Service current status (removal) (p. 57, line 3396): "removed from the"
       - F-sig: Signed with a compact JAdES Baseline B signature (ETSI TS 119 182-1). [checkable: yes: with a JAdES / XAdES verifier] F.4 Signature (p. 57, line 3419): "shall be signed by means of a compact JAdES Baseline B signature"
-->
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt">
  <sch:ns prefix="lote" uri="http://uri.etsi.org/019602/v1#"/>
  <sch:ns prefix="tie" uri="http://uri.etsi.org/019602/v1/TrustedEntityExtensions"/>
  <sch:ns prefix="sie" uri="http://uri.etsi.org/019602/v1/ServiceInformationExtensions"/>
  <sch:ns prefix="ds" uri="http://www.w3.org/2000/09/xmldsig#"/>
  <sch:pattern id="p-F-LoTEVersionIdentifier-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEVersionIdentifier">
      <sch:assert id="F-LoTEVersionIdentifier-fixed" test=". = '1'">[F-LoTEVersionIdentifier-fixed] LoTEVersionIdentifier must be "1". Table F.1 LoTE version identifier (p. 55, line 3266): "The value of the LoTEVersionIdentifier component shall be "1"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-LoTEType-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEType">
      <sch:assert id="F-LoTEType-fixed" test=". = 'http://uri.etsi.org/19602/LoTEType/EUWRPACProvidersList'">[F-LoTEType-fixed] LoTEType must be "http://uri.etsi.org/19602/LoTEType/EUWRPACProvidersList". Table F.1 LoTE type (p. 55, line 3271): "http://uri.etsi.org/19602/LoTEType/EUWRPACProvidersList"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-StatusDeterminationApproach-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:StatusDeterminationApproach">
      <sch:assert id="F-StatusDeterminationApproach-fixed" test=". = 'http://uri.etsi.org/19602/WRPACProvidersList/StatusDetn/EU'">[F-StatusDeterminationApproach-fixed] StatusDeterminationApproach must be "http://uri.etsi.org/19602/WRPACProvidersList/StatusDetn/EU". Table F.1 Status determination approach (p. 55, line 3281): "http://uri.etsi.org/19602/WRPACProvidersList/StatusDetn/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-SchemeTypeCommunityRules-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTypeCommunityRules/lote:URI">
      <sch:assert id="F-SchemeTypeCommunityRules-fixed" test=". = 'http://uri.etsi.org/19602/WRPACProvidersList/schemerules/EU'">[F-SchemeTypeCommunityRules-fixed] SchemeTypeCommunityRules must be "http://uri.etsi.org/19602/WRPACProvidersList/schemerules/EU". Table F.1 Scheme type/community/rules (p. 55, line 3283): "http://uri.etsi.org/19602/WRPACProvidersList/schemerules/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-SchemeTerritory-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTerritory">
      <sch:assert id="F-SchemeTerritory-fixed" test=". = 'EU'">[F-SchemeTerritory-fixed] SchemeTerritory must be "EU". Table F.1 Scheme territory (p. 55, line 3285): "The value of the SchemeTerritory component shall be "EU"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-next-6m">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="F-next-6m" test="not(lote:NextUpdate/lote:dateTime) or (number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) &lt; (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 or ((number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) = (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 and number(translate(substring(lote:NextUpdate/lote:dateTime, 9), 'T:Z', '')) &lt;= number(translate(substring(lote:ListIssueDateTime, 9), 'T:Z', '')))">[F-next-6m] NextUpdate is at most 6 months after ListIssueDateTime.. Table F.1 Next update (p. 55, line 3296): "The maximum value between the list issue date and time and the next update shall be 6 months."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-HistoricalInformationPeriod-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="F-HistoricalInformationPeriod-prohibited" test="not(lote:HistoricalInformationPeriod)">[F-HistoricalInformationPeriod-prohibited] HistoricalInformationPeriod must not be present. Table F.1 Historical information period (p. 55, line 3289): "The HistoricalInformationPeriod component shall not be present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-PointersToOtherLoTE-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="F-PointersToOtherLoTE-required" test="lote:PointersToOtherLoTE">[F-PointersToOtherLoTE-required] PointersToOtherLoTE is required. Table F.1 Pointers to other LoTEs (p. 55, line 3292): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-ptr-self">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:PointersToOtherLoTE">
      <sch:assert id="F-ptr-self" test="lote:OtherLoTEPointer[lote:LoTEQualifiers/lote:LoTEQualifier[lote:LoTEType = 'http://uri.etsi.org/19602/LoTEType/EUWRPACProvidersList']]">[F-ptr-self] One pointer designates this list itself (identified here by its LoTEType qualifier).. Table F.1 Pointers to other LoTEs (p. 55, line 3292): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-te-tel">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation/lote:TEAddress">
      <sch:assert id="F-te-tel" test="lote:TEElectronicAddress/lote:URI[(starts-with(., 'tel:'))]">[F-te-tel] The electronic address contains a contact phone number (tel: URI).. Table F.2 TE address (p. 56, line 3336): "contact email and contact phone number"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-te-info-count">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="F-te-info-count" test="count(lote:TEInformationURI/lote:URI) &gt;= 2">[F-te-info-count] At least the policy page (a) and the Member State URI (c).. Table F.2 TE information URI (p. 56, line 3339): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-te-info-a">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="F-te-info-a" test="lote:TEInformationURI/lote:URI[(starts-with(., 'http://') or starts-with(., 'https://')) and not(starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/'))]">[F-te-info-a] (a) An http(s) page with the provider's policies, terms and conditions.. Table F.2 TE information URI (p. 56, line 3339): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-te-cc">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="F-te-cc" test="lote:TEInformationURI/lote:URI[starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/WRPACProvider/') and contains(' AT BE BG CY CZ DE DK EE EL ES FI FR HR HU IE IT LT LU LV MT NL PL PT RO SE SI SK ', concat(' ', substring-after(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/WRPACProvider/'), ' '))]">[F-te-cc] (c) http://uri.etsi.org/19602/ListOfTrustedEntities/WRPACProvider/CC for the responsible Member State ('CC' field: Greece = EL, clause 6.1.5).. Table F.2 TE information URI (Member State URI) (p. 56, line 3348): ""CC" is replaced by the ISO 3166-1 [2] Alpha 2 code of the Member State which is responsible for that"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-ServiceTypeIdentifier-values">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceTypeIdentifier">
      <sch:assert id="F-ServiceTypeIdentifier-values" test=". = 'http://uri.etsi.org/19602/SvcType/WRPAC/Issuance' or . = 'http://uri.etsi.org/19602/SvcType/WRPAC/Revocation'">[F-ServiceTypeIdentifier-values] ServiceTypeIdentifier must be one of the allowed values. Table F.3 Service type identifier (p. 57, line 3371): "to the exclusion of any other"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-X509Certificate-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceDigitalIdentity">
      <sch:assert id="F-X509Certificate-required" test="lote:DigitalId/lote:X509Certificate">[F-X509Certificate-required] X509Certificate is required. Table F.3 Service digital identity (p. 57, line 3379): "The ServiceDigitalIdentity component shall contain one or more"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-ServiceStatus-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="F-ServiceStatus-prohibited" test="not(lote:ServiceStatus)">[F-ServiceStatus-prohibited] ServiceStatus must not be present. Table F.3 Service current status (p. 57, line 3385): "The ServiceStatus component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-StatusStartingTime-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="F-StatusStartingTime-prohibited" test="not(lote:StatusStartingTime)">[F-StatusStartingTime-prohibited] StatusStartingTime must not be present. Table F.3 Current status starting date and time (p. 57, line 3397): "The StatusStartingTime component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-F-ServiceHistory-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService">
      <sch:assert id="F-ServiceHistory-prohibited" test="not(lote:ServiceHistory)">[F-ServiceHistory-prohibited] ServiceHistory must not be present. Table F.1 Historical information period (consequence) (p. 55, line 3290): "historical information is not kept in the list"</sch:assert>
    </sch:rule>
  </sch:pattern>
</sch:schema>
