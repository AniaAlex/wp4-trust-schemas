<?xml version="1.0" encoding="UTF-8"?>
<!-- ETSI TS 119 602 V1.1.1 Annex E - Wallet providers list (generated by lote_schema_generator/gen_profiles_from_model.py). Use together with ../base/lote_core.xsd and ../base/lote_core.sch.
     Rules-layer requirements (not checkable by a schema):
       - E-seq-1: The first instance of the list is issued with LoTESequenceNumber 1. [checkable: no: list-history] Table E.1 LoTE sequence number (p. 51, line 3065): "LoTESequenceNumber component number set to "1"."
       - E-sch-info: One URI for information about the list and one where all previous instances can be retrieved; one URI may serve both, so the count is not enforced. [checkable: no: page-content] Table E.1 Scheme information URI (p. 51, line 3073): "The SchemeInformationURI component shall contain:"
       - E-te-name: TEName is the (legal) name of the listed provider. [checkable: no: official-records] Table E.2 TE name (p. 52, line 3115): "The value of the TEName component shall be the name of the"
       - E-trade: The official registration identifier where one exists (organizationIdentifier / serialNumber semantics of ETSI EN 319 412-1). [checkable: no: official-records] Table E.2 TE trade name (p. 52, line 3117): "The TETradeName component shall include an official registration"
       - E-assoc: Where applicable, OtherAssociatedBodies names the associated body responsible for the provision of the wallet solution. [checkable: no: where-applicable] Table E.2 TE information extensions (p. 52, line 3143): "Where applicable, the OtherAssociatedBody extension shall be used"
       - E-svc-name: The name of a wallet solution as published in the Official Journal. [checkable: no: official-journal] Table E.3 Service name (p. 53, line 3170): "The value of the ServiceName component shall be the name of a wallet"
       - E-sdi-content: The certificates certify the TEName and, where applicable, the TETradeName registration number. [checkable: no: certificate-parsing] Table E.3 Service digital identity (certificate content) (p. 53, line 3179): "certified identity data includes the name"
       - E-removal: An entity or service that loses its approval is removed from the list. [checkable: no: operational-process] Table E.3 Service current status (removal) (p. 53, line 3191): "removed from the"
       - E-sui: The reference number of the wallet solution as published in the Official Journal. [checkable: no: official-journal] Table E.3 Service information extensions (p. 53, line 3209): "The ServiceUniqueIdentifier extension shall be used to provide the"
       - E-sig: Signed with a compact JAdES Baseline B signature (ETSI TS 119 182-1). [checkable: yes, by xml: signature-verifier, json: signature-verifier] E.4 Signature (p. 53, line 3220): "shall be signed by means of a compact JAdES Baseline B signature"
-->
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt">
  <sch:ns prefix="lote" uri="http://uri.etsi.org/019602/v1#"/>
  <sch:ns prefix="tie" uri="http://uri.etsi.org/019602/v1/TrustedEntityExtensions"/>
  <sch:ns prefix="sie" uri="http://uri.etsi.org/019602/v1/ServiceInformationExtensions"/>
  <sch:ns prefix="ds" uri="http://www.w3.org/2000/09/xmldsig#"/>
  <sch:pattern id="p-E-LoTEVersionIdentifier-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEVersionIdentifier">
      <sch:assert id="E-LoTEVersionIdentifier-fixed" test=". = '1'">[E-LoTEVersionIdentifier-fixed] LoTEVersionIdentifier must be "1". Table E.1 LoTE version identifier (p. 51, line 3062): "The value of the LoTEVersionIdentifier component shall be "1"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-LoTEType-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEType">
      <sch:assert id="E-LoTEType-fixed" test=". = 'http://uri.etsi.org/19602/LoTEType/EUWalletProvidersList'">[E-LoTEType-fixed] LoTEType must be "http://uri.etsi.org/19602/LoTEType/EUWalletProvidersList". Table E.1 LoTE type (p. 51, line 3067): "http://uri.etsi.org/19602/LoTEType/EUWalletProvidersList"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-StatusDeterminationApproach-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:StatusDeterminationApproach">
      <sch:assert id="E-StatusDeterminationApproach-fixed" test=". = 'http://uri.etsi.org/19602/WalletProvidersList/StatusDetn/EU'">[E-StatusDeterminationApproach-fixed] StatusDeterminationApproach must be "http://uri.etsi.org/19602/WalletProvidersList/StatusDetn/EU". Table E.1 Status determination approach (p. 51, line 3077): "http://uri.etsi.org/19602/WalletProvidersList/StatusDetn/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-SchemeTypeCommunityRules-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTypeCommunityRules/lote:URI">
      <sch:assert id="E-SchemeTypeCommunityRules-fixed" test=". = 'http://uri.etsi.org/19602/WalletProvidersList/schemerules/EU'">[E-SchemeTypeCommunityRules-fixed] SchemeTypeCommunityRules must be "http://uri.etsi.org/19602/WalletProvidersList/schemerules/EU". Table E.1 Scheme type/community/rules (p. 51, line 3079): "http://uri.etsi.org/19602/WalletProvidersList/schemerules/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-SchemeTerritory-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTerritory">
      <sch:assert id="E-SchemeTerritory-fixed" test=". = 'EU'">[E-SchemeTerritory-fixed] SchemeTerritory must be "EU". Table E.1 Scheme territory (p. 51, line 3080): "The value of the SchemeTerritory component shall be "EU"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-next-6m">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="E-next-6m" test="not(lote:NextUpdate/lote:dateTime) or (number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) &lt; (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 or ((number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) = (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 and number(translate(substring(lote:NextUpdate/lote:dateTime, 9), 'T:Z', '')) &lt;= number(translate(substring(lote:ListIssueDateTime, 9), 'T:Z', '')))">[E-next-6m] NextUpdate is at most 6 months after ListIssueDateTime.. Table E.1 Next update (p. 51, line 3091): "The maximum value between the list issue date and time and the next update shall be 6 months."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-HistoricalInformationPeriod-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="E-HistoricalInformationPeriod-prohibited" test="not(lote:HistoricalInformationPeriod)">[E-HistoricalInformationPeriod-prohibited] HistoricalInformationPeriod must not be present. Table E.1 Historical information period (p. 51, line 3084): "The HistoricalInformationPeriod component shall not be present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-PointersToOtherLoTE-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="E-PointersToOtherLoTE-required" test="lote:PointersToOtherLoTE">[E-PointersToOtherLoTE-required] PointersToOtherLoTE is required. Table E.1 Pointers to other LoTEs (p. 51, line 3087): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-ptr-self">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:PointersToOtherLoTE">
      <sch:assert id="E-ptr-self" test="lote:OtherLoTEPointer[lote:LoTEQualifiers/lote:LoTEQualifier[lote:LoTEType = 'http://uri.etsi.org/19602/LoTEType/EUWalletProvidersList']]">[E-ptr-self] One pointer designates this list itself (identified here by its LoTEType qualifier).. Table E.1 Pointers to other LoTEs (p. 51, line 3087): "The PointersToOtherLoTE component shall contain a pointer to the present"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-te-tel">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation/lote:TEAddress">
      <sch:assert id="E-te-tel" test="lote:TEElectronicAddress/lote:URI[(starts-with(., 'tel:'))]">[E-te-tel] The electronic address contains a contact phone number (tel: URI).. Table E.2 TE address (p. 52, line 3130): "contact email and contact phone number"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-te-info-count">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="E-te-info-count" test="count(lote:TEInformationURI/lote:URI) &gt;= 2">[E-te-info-count] At least the policy page (a) and the Member State URI (c).. Table E.2 TE information URI (p. 52, line 3132): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-te-info-a">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="E-te-info-a" test="lote:TEInformationURI/lote:URI[(starts-with(., 'http://') or starts-with(., 'https://')) and not(starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/'))]">[E-te-info-a] (a) An http(s) page with the provider's policies, terms and conditions.. Table E.2 TE information URI (p. 52, line 3132): "The TEInformationURI component shall contain:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-te-cc">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="E-te-cc" test="lote:TEInformationURI/lote:URI[starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/WalletProvider/') and contains(' AT BE BG CY CZ DE DK EE EL ES FI FR HR HU IE IT LT LU LV MT NL PL PT RO SE SI SK ', concat(' ', substring-after(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/WalletProvider/'), ' '))]">[E-te-cc] (c) http://uri.etsi.org/19602/ListOfTrustedEntities/WalletProvider/CC for the responsible Member State ('CC' field: Greece = EL, clause 6.1.5).. Table E.2 TE information URI (Member State URI) (p. 52, line 3140): ""CC" is replaced by the ISO 3166-1 [2] Alpha 2 code of the Member State which is responsible for that"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-ServiceTypeIdentifier-values">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceTypeIdentifier">
      <sch:assert id="E-ServiceTypeIdentifier-values" test=". = 'http://uri.etsi.org/19602/SvcType/WalletSolution/Issuance' or . = 'http://uri.etsi.org/19602/SvcType/WalletSolution/Revocation'">[E-ServiceTypeIdentifier-values] ServiceTypeIdentifier must be one of the allowed values. Table E.3 Service type identifier (p. 53, line 3164): "to the exclusion of any other"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-X509Certificate-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceDigitalIdentity">
      <sch:assert id="E-X509Certificate-required" test="lote:DigitalId/lote:X509Certificate">[E-X509Certificate-required] X509Certificate is required. Table E.3 Service digital identity (p. 53, line 3175): "The ServiceDigitalIdentity component shall contain one or more"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-ServiceStatus-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="E-ServiceStatus-prohibited" test="not(lote:ServiceStatus)">[E-ServiceStatus-prohibited] ServiceStatus must not be present. Table E.3 Service current status (p. 53, line 3182): "The ServiceStatus component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-StatusStartingTime-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="E-StatusStartingTime-prohibited" test="not(lote:StatusStartingTime)">[E-StatusStartingTime-prohibited] StatusStartingTime must not be present. Table E.3 Current status starting date and time (p. 53, line 3195): "The StatusStartingTime component shall not be used."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-ServiceHistory-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService">
      <sch:assert id="E-ServiceHistory-prohibited" test="not(lote:ServiceHistory)">[E-ServiceHistory-prohibited] ServiceHistory must not be present. Table E.1 Historical information period (consequence) (p. 51, line 3085): "historical information is not kept in the list"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-ServiceUniqueIdentifier-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="E-ServiceUniqueIdentifier-required" test="lote:ServiceInformationExtensions/lote:Extension/sie:ServiceUniqueIdentifier">[E-ServiceUniqueIdentifier-required] ServiceUniqueIdentifier is required. Table E.3 Service information extensions (p. 53, line 3209): "The ServiceUniqueIdentifier extension shall be used to provide the"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-sig-ref-uri">
    <sch:rule context="/lote:ListOfTrustedEntities/ds:Signature">
      <sch:assert id="E-sig-ref-uri" test="ds:SignedInfo/ds:Reference[@URI='']">[E-sig-ref-uri] WP4 rule (project_decisions_vs_etsi.md #2): ds:SignedInfo has a ds:Reference with URI="" (the entire document). H.4 Signature (p. 66, line 3863): "Its ds:SignedInfo element shall contain a ds:Reference element with the URI attribute set to an"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-sig-transforms">
    <sch:rule context="/lote:ListOfTrustedEntities/ds:Signature">
      <sch:assert id="E-sig-transforms" test="not(ds:SignedInfo/ds:Reference[@URI='']) or ds:SignedInfo/ds:Reference[@URI=''][count(ds:Transforms)=1][count(ds:Transforms/ds:Transform)=2][ds:Transforms/ds:Transform[1]/@Algorithm='http://www.w3.org/2000/09/xmldsig#enveloped-signature'][ds:Transforms/ds:Transform[2]/@Algorithm='http://www.w3.org/2001/10/xml-exc-c14n#']">[E-sig-transforms] WP4 rule (project_decisions_vs_etsi.md #2): The ds:Reference with URI="" has one ds:Transforms with two ds:Transform: enveloped-signature, then exclusive canonicalization. H.4 Signature (p. 66, line 3869): "This ds:Transforms element shall contain two ds:Transform elements."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-E-sig-c14n">
    <sch:rule context="/lote:ListOfTrustedEntities/ds:Signature">
      <sch:assert id="E-sig-c14n" test="ds:SignedInfo/ds:CanonicalizationMethod/@Algorithm='http://www.w3.org/2001/10/xml-exc-c14n#'">[E-sig-c14n] WP4 rule (project_decisions_vs_etsi.md #2): ds:SignedInfo is canonicalized with exclusive canonicalization. H.4 Signature (p. 66, line 3875): "ds:CanonicalizationMethod shall be "http://www.w3.org/2001/10/xml-exc-c14n#"."</sch:assert>
    </sch:rule>
  </sch:pattern>
</sch:schema>
