<?xml version="1.0" encoding="UTF-8"?>
<!-- ETSI TS 119 602 V1.1.1 Annex H - Pub-EAA providers list (generated by lote_schema_generator/gen_profiles_from_model.py). Use together with lote_core.xsd and lote_core.sch.
     Rules-layer requirements (not checkable by a schema):
       - H-seq-1: The first instance of the list is issued with LoTESequenceNumber 1. [checkable: partly: needs the list history] Table H.1 LoTE sequence number (p. 63, line 3669): "LoTESequenceNumber component number set to "1"."
       - H-sch-info: One URI where users can receive information about the list. [checkable: no: content of the page] Table H.1 Scheme information URI (p. 63, line 3676): "The SchemeInformationURI component shall contain a URI where"
       - H-te-name: TEName is the (legal) name of the listed provider. [checkable: no: needs official records] Table H.2 TE name (p. 64, line 3714): "The value of the TEName component shall be the name of the"
       - H-trade-id: Includes the official registration identifier where one exists (organizationIdentifier / serialNumber semantics of ETSI EN 319 412-1). [checkable: no: needs official records] Table H.2 TE trade name (registration identifier) (p. 64, line 3721): "An official registration identifier as registered in official records,"
       - H-te-info: The URL of the page with policies, terms and conditions. [checkable: no: content of the page] Table H.2 TE information URI (p. 64, line 3758): "The TEInformationURI component shall contain the URL of the"
       - H-sdi-key: Multiple certificates all relate to the same public key and have identical subject names. [checkable: partly: needs certificate parsing] Table H.3 Service digital identity (p. 65, line 3792): "The ServiceDigitalIdentity component may contain one or more X.509"
       - H-sdi-org: Each certificate's subject has organizationName, strictly matching TEName. [checkable: partly: needs certificate parsing] Table H.3 Service digital identity (organizationName) (p. 65, line 3807): "The organizationName attribute present in the subject name shall strictly"
       - H-withdrawn: When an entity is no longer a provider, all its services are set to withdrawn. [checkable: no: operational process] Table H.3 Service current status (withdrawal) (p. 65, line 3823): "shall have their current status set to"
       - H-start: The starting time of a new current status is not before the (re)issuance of the list. [checkable: partly: needs the previous list] Table H.3 Current status starting date and time (p. 65, line 3829): "shall not be set before the date of (re)issuance of the LoTE"
       - H-sig: Signed with a compact JAdES Baseline B signature (ETSI TS 119 182-1) when issued in JSON; in XML an enveloped XAdES Baseline B signature (H.4 1-4). [checkable: yes: with a JAdES / XAdES verifier] H.4 Signature (p. 66, line 3855): "When a JSON binding is used to issue the Pub-EAA providers list, the list shall be signed by means of a compact"
-->
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt">
  <sch:ns prefix="lote" uri="http://uri.etsi.org/019602/v1#"/>
  <sch:ns prefix="tie" uri="http://uri.etsi.org/019602/v1/TrustedEntityExtensions"/>
  <sch:ns prefix="sie" uri="http://uri.etsi.org/019602/v1/ServiceInformationExtensions"/>
  <sch:ns prefix="ds" uri="http://www.w3.org/2000/09/xmldsig#"/>
  <sch:pattern id="p-H-LoTEVersionIdentifier-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEVersionIdentifier">
      <sch:assert id="H-LoTEVersionIdentifier-fixed" test=". = '1'">[H-LoTEVersionIdentifier-fixed] LoTEVersionIdentifier must be "1". Table H.1 LoTE version identifier (p. 63, line 3667): "The value of the LoTEVersionIdentifier component shall be "1"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-LoTEType-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:LoTEType">
      <sch:assert id="H-LoTEType-fixed" test=". = 'http://uri.etsi.org/19602/LoTEType/EUPubEAAProvidersList'">[H-LoTEType-fixed] LoTEType must be "http://uri.etsi.org/19602/LoTEType/EUPubEAAProvidersList". Table H.1 LoTE type (p. 63, line 3671): "http://uri.etsi.org/19602/LoTEType/EUPubEAAProvidersList"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-StatusDeterminationApproach-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:StatusDeterminationApproach">
      <sch:assert id="H-StatusDeterminationApproach-fixed" test=". = 'http://uri.etsi.org/19602/PubEAAProvidersList/StatusDetn/EU'">[H-StatusDeterminationApproach-fixed] StatusDeterminationApproach must be "http://uri.etsi.org/19602/PubEAAProvidersList/StatusDetn/EU". Table H.1 Status determination approach (p. 63, line 3679): "http://uri.etsi.org/19602/PubEAAProvidersList/StatusDetn/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-SchemeTypeCommunityRules-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTypeCommunityRules/lote:URI">
      <sch:assert id="H-SchemeTypeCommunityRules-fixed" test=". = 'http://uri.etsi.org/19602/PubEAAProvidersList/schemerules/EU'">[H-SchemeTypeCommunityRules-fixed] SchemeTypeCommunityRules must be "http://uri.etsi.org/19602/PubEAAProvidersList/schemerules/EU". Table H.1 Scheme type/community/rules (p. 63, line 3681): "http://uri.etsi.org/19602/PubEAAProvidersList/schemerules/EU"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-SchemeTerritory-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:SchemeTerritory">
      <sch:assert id="H-SchemeTerritory-fixed" test=". = 'EU'">[H-SchemeTerritory-fixed] SchemeTerritory must be "EU". Table H.1 Scheme territory (p. 63, line 3682): "The value of the SchemeTerritory component shall be "EU"."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-next-6m">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="H-next-6m" test="not(lote:NextUpdate/lote:dateTime) or (number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) &lt; (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 or ((number(substring(lote:NextUpdate/lote:dateTime, 1, 4)) * 12 + number(substring(lote:NextUpdate/lote:dateTime, 6, 2))) = (number(substring(lote:ListIssueDateTime, 1, 4)) * 12 + number(substring(lote:ListIssueDateTime, 6, 2))) + 6 and number(translate(substring(lote:NextUpdate/lote:dateTime, 9), 'T:Z', '')) &lt;= number(translate(substring(lote:ListIssueDateTime, 9), 'T:Z', '')))">[H-next-6m] NextUpdate is at most 6 months after ListIssueDateTime.. Table H.1 Next update (p. 63, line 3691): "The maximum value between the list issue date and time and the next update shall be 6 months."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-HistoricalInformationPeriod-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="H-HistoricalInformationPeriod-required" test="lote:HistoricalInformationPeriod">[H-HistoricalInformationPeriod-required] HistoricalInformationPeriod is required. Table H.1 Historical information period (p. 63, line 3685): "The HistoricalInformationPeriod component shall be present with"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-HistoricalInformationPeriod-fixed">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation/lote:HistoricalInformationPeriod">
      <sch:assert id="H-HistoricalInformationPeriod-fixed" test=". = '65535'">[H-HistoricalInformationPeriod-fixed] HistoricalInformationPeriod must be "65535". Table H.1 Historical information period (p. 63, line 3685): "The HistoricalInformationPeriod component shall be present with"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-PointersToOtherLoTE-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:ListAndSchemeInformation">
      <sch:assert id="H-PointersToOtherLoTE-prohibited" test="not(lote:PointersToOtherLoTE)">[H-PointersToOtherLoTE-prohibited] PointersToOtherLoTE must not be present. Table H.1 Pointers to other LoTEs (p. 63, line 3687): "The PointersToOtherLoTE component shall not be present."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-TETradeName-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="H-TETradeName-required" test="lote:TETradeName">[H-TETradeName-required] TETradeName is required. Table H.2 TE trade name (p. 64, line 3720): "The TETradeName component shall include:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-trade-oj">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation">
      <sch:assert id="H-trade-oj" test="lote:TETradeName/lote:Name[starts-with(., 'OJ:') and contains(' EU AT BE BG CY CZ DE DK EE GR ES FI FR HR HU IE IT LT LU LV MT NL PL PT RO SE SI SK ', concat(' ', substring(substring-after(., 'OJ:'), 1, 2), ' ')) and string-length(substring-after(., 'OJ:')) &gt; 2]">[H-trade-oj] One entry references the Union or national law: 'OJ:' + 'EU' or the ISO 3166-1 code of the Member State (Greece = GR, not EL: not denoted 'CC') + an identifier of the law.. Table H.2 TE trade name (law reference) (p. 64, line 3740): ""OJ:" for the scheme part; followed by"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-te-tel">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation/lote:TEAddress">
      <sch:assert id="H-te-tel" test="lote:TEElectronicAddress/lote:URI[(starts-with(., 'tel:'))]">[H-te-tel] The electronic address contains a contact phone number (tel: URI).. Table H.2 TE address (p. 64, line 3751): "contact email and contact phone number"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-te-cc">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation/lote:TEAddress">
      <sch:assert id="H-te-cc" test="lote:TEElectronicAddress/lote:URI[starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/PubEAAProvider/') and contains(' AT BE BG CY CZ DE DK EE EL ES FI FR HR HU IE IT LT LU LV MT NL PL PT RO SE SI SK ', concat(' ', substring-after(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/PubEAAProvider/'), ' '))]">[H-te-cc] The electronic address contains http://uri.etsi.org/19602/ListOfTrustedEntities/PubEAAProvider/CC for the responsible Member State ('CC' field: Greece = EL, clause 6.1.5). Placed here by Table H.2; the other annexes place it under TE information URI (etsi_defects.md #14).. Table H.2 TE address (Member State URI) (p. 64, line 3755): ""CC" is replaced by the ISO 3166-1 [2] Alpha 2 code of the Member State which is responsible for that"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-te-web">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityInformation/lote:TEAddress">
      <sch:assert id="H-te-web" test="lote:TEElectronicAddress/lote:URI[(starts-with(., 'http://') or starts-with(., 'https://')) and not(starts-with(., 'http://uri.etsi.org/19602/ListOfTrustedEntities/'))]">[H-te-web] Because Table H.2 places the ETSI Member State URI in the electronic address, the web-site that clause 6.3.5.2 requires must be another http(s) URI.. Table H.2 TE address (web-site) (p. 64, line 3755): ""CC" is replaced by the ISO 3166-1 [2] Alpha 2 code of the Member State which is responsible for that"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-ServiceTypeIdentifier-values">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceTypeIdentifier">
      <sch:assert id="H-ServiceTypeIdentifier-values" test=". = 'http://uri.etsi.org/19602/SvcType/PubEAA/Issuance' or . = 'http://uri.etsi.org/19602/SvcType/PubEAA/Revocation'">[H-ServiceTypeIdentifier-values] ServiceTypeIdentifier must be one of the allowed values. Table H.3 Service type identifier (p. 64, line 3776): "to the exclusion of any other"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-ServiceStatus-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation">
      <sch:assert id="H-ServiceStatus-required" test="lote:ServiceStatus">[H-ServiceStatus-required] ServiceStatus is required. Table H.3 Service current status (p. 65, line 3809): "The ServiceStatus component shall be present."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-ServiceStatus-values">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceInformation/lote:ServiceStatus">
      <sch:assert id="H-ServiceStatus-values" test=". = 'http://uri.etsi.org/19602/PubEAAProvidersList/SvcStatus/notified' or . = 'http://uri.etsi.org/19602/PubEAAProvidersList/SvcStatus/withdrawn'">[H-ServiceStatus-values] ServiceStatus must be one of the allowed values. Table H.3 Service current status (values) (p. 65, line 3810): "The following values may be used to the exclusion of any other:"</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-X509SKI-required">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceHistory/lote:ServiceHistoryInstance/lote:ServiceDigitalIdentity">
      <sch:assert id="H-X509SKI-required" test="lote:DigitalId/lote:X509SKI">[H-X509SKI-required] X509SKI is required. Table H.3 History information (SKI) (p. 65, line 3842): "shall contain at least the X509SKI component."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-X509Certificate-prohibited">
    <sch:rule context="/lote:ListOfTrustedEntities/lote:TrustedEntitiesList/lote:TrustedEntity/lote:TrustedEntityServices/lote:TrustedEntityService/lote:ServiceHistory/lote:ServiceHistoryInstance/lote:ServiceDigitalIdentity">
      <sch:assert id="H-X509Certificate-prohibited" test="not(lote:DigitalId/lote:X509Certificate)">[H-X509Certificate-prohibited] X509Certificate must not be present. Table H.3 History information (no certificate) (p. 65, line 3844): "shall not contain an X509Certificate component."</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern id="p-H-Signature-xml-required">
    <sch:rule context="/lote:ListOfTrustedEntities">
      <sch:assert id="H-Signature-xml-required" test="ds:Signature">[H-Signature-xml-required] Signature is required in XML. H.4 Signature (p. 66, line 3858): "When an XML binding is used to issue the Pub-EAA providers list, the Signature component shall be present with a"</sch:assert>
    </sch:rule>
  </sch:pattern>
</sch:schema>
